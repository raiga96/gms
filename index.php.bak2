<?php
session_start();
require 'includes/connection.php';

// =============================================================================
// PHASE 1: HERO STATS (Zone, Sub-Zone, Perimeter, Area)
// =============================================================================
// Total Zone
$sql_zone = "SELECT COUNT(*) AS total_zone FROM zone";
$res_zone = $conn->query($sql_zone);
$total_zone = ($res_zone && $row = $res_zone->fetch_assoc()) ? (int)$row['total_zone'] : 0;

// Total Sub-Zone, Perimeter, Area
$sql_sub_stats = "SELECT COUNT(*) AS total_subzone, COALESCE(SUM(perimeter), 0) AS total_perimeter, COALESCE(SUM(area), 0) AS total_area FROM subzone";
$res_sub_stats = $conn->query($sql_sub_stats);
$sub_stats = ($res_sub_stats && $row = $res_sub_stats->fetch_assoc()) ? $row : ['total_subzone' => 0, 'total_perimeter' => 0, 'total_area' => 0];
$total_subzone = (int)$sub_stats['total_subzone'];
$total_perimeter = (float)$sub_stats['total_perimeter'];
$total_area = (float)$sub_stats['total_area'];

// =============================================================================
// EXISTING QUERIES (Preserved for backward compatibility)
// =============================================================================
// Total Contract
$sql_tc = "SELECT COUNT(*) AS total_contract FROM contract";
$res_tc = $conn->query($sql_tc);
$row_tc = $res_tc ? $res_tc->fetch_assoc() : ['total_contract' => 0];
$total_contract = (int)$row_tc['total_contract'];

// Total Contractor
$sql_tcon = "SELECT COUNT(*) AS total_contractor FROM contractor";
$res_tcon = $conn->query($sql_tcon);
$row_tcon = $res_tcon ? $res_tcon->fetch_assoc() : ['total_contractor' => 0];
$total_contractor = (int)$row_tcon['total_contractor'];

// Calculate current session
$current_month = (int)date('n');
$current_day = (int)date('j');
$session_num = ($current_month - 1) * 2 + ($current_day <= 15 ? 1 : 2);
$current_session = "Session " . $session_num;
$session_cycle = ($current_day <= 15 ? "Kitaran 1 (1 - 15 " . date('M') . ")" : "Kitaran 2 (16 - " . date('t M') . ")");

// Contractors Data
$contractors_sql = "
    SELECT
        c.cid,
        c.name,
        COUNT(ct.contract_id) as jumlah_contract,
        GROUP_CONCAT(ct.contract_number SEPARATOR ', ') as number_contract,
        GROUP_CONCAT(sz.sz_name SEPARATOR ', ') as zone_names
    FROM contractor c
    LEFT JOIN contract ct ON c.cid = ct.cid
    LEFT JOIN subzone sz ON ct.sz_id = sz.sz_id
    GROUP BY c.cid
";
$contractors_res = $conn->query($contractors_sql);

// =============================================================================
// PHASE 2 & 3: TODAY'S OPERATIONS METRICS
// =============================================================================
// Rekod disahkan hari ini
$sql_verified_today = "SELECT COUNT(*) AS verified_today FROM daily_records WHERE verified = 'Y' AND DATE(verified_on) = CURDATE()";
$res_verified_today = $conn->query($sql_verified_today);
$verified_today = ($res_verified_today && $row = $res_verified_today->fetch_assoc()) ? (int)$row['verified_today'] : 0;

// Rekod menunggu verifikasi (semua yang belum disahkan dan tarikh <= hari ini)
$sql_pending = "SELECT COUNT(*) AS pending_verification FROM daily_records WHERE verified = 'N' AND date <= CURDATE()";
$res_pending = $conn->query($sql_pending);
$pending_verification = ($res_pending && $row = $res_pending->fetch_assoc()) ? (int)$row['pending_verification'] : 0;

// Operasi aktif hari ini (rekod yang dicipta untuk tarikh hari ini)
$sql_active = "SELECT COUNT(*) AS active_today FROM daily_records WHERE date = CURDATE()";
$res_active = $conn->query($sql_active);
$active_today = ($res_active && $row = $res_active->fetch_assoc()) ? (int)$row['active_today'] : 0;

// =============================================================================
// PHASE 4: ZONE STATUS GRID (Per-zone summary with daily_records join)
// =============================================================================
$zones_data = [];
$sql_zones = "
    SELECT
        z.zone_id,
        z.zone_name,
        COUNT(DISTINCT sz.sz_id) AS total_subzone,
        COALESCE(SUM(CASE WHEN dr.verified = 'Y' AND DATE(dr.verified_on) = CURDATE() THEN 1 ELSE 0 END), 0) AS verified_today,
        COALESCE(SUM(CASE WHEN dr.verified = 'N' AND dr.date <= CURDATE() THEN 1 ELSE 0 END), 0) AS pending
    FROM zone z
    LEFT JOIN subzone sz ON sz.zone_id = z.zone_id
    LEFT JOIN contract ct ON ct.sz_id = sz.sz_id AND ct.c_status = 'Y'
    LEFT JOIN daily_records dr ON dr.cid = ct.contract_id
    GROUP BY z.zone_id, z.zone_name
    ORDER BY z.zone_name ASC
";
$res_zones = $conn->query($sql_zones);
if ($res_zones && $res_zones->num_rows > 0) {
    while ($row = $res_zones->fetch_assoc()) {
        $zones_data[] = [
            'zone_id' => (int)$row['zone_id'],
            'zone_name' => $row['zone_name'],
            'total_subzone' => (int)$row['total_subzone'],
            'verified_today' => (int)$row['verified_today'],
            'pending' => (int)$row['pending'],
        ];
    }
}

// =============================================================================
// PHASE 5: CONTRACT FUND DISTRIBUTION (Donut chart data)
// =============================================================================
$fund_distribution = [];
$total_fund_all = 0;
$sql_fund = "
    SELECT z.zone_name, COALESCE(SUM(ct.fund), 0) AS total_fund
    FROM zone z
    JOIN subzone sz ON sz.zone_id = z.zone_id
    JOIN contract ct ON ct.sz_id = sz.sz_id
    WHERE ct.c_status = 'Y'
    GROUP BY z.zone_id, z.zone_name
    HAVING total_fund > 0
    ORDER BY total_fund DESC
";
$res_fund = $conn->query($sql_fund);
if ($res_fund && $res_fund->num_rows > 0) {
    while ($row = $res_fund->fetch_assoc()) {
        $fund_distribution[] = [
            'zone_name' => $row['zone_name'],
            'total_fund' => (float)$row['total_fund'],
        ];
        $total_fund_all += (float)$row['total_fund'];
    }
}
$fund_labels_json = json_encode(array_column($fund_distribution, 'zone_name'));
$fund_data_json = json_encode(array_column($fund_distribution, 'total_fund'));

// =============================================================================
// HELPER: Deterministic sparkline points (seeded by metric id + day-of-year)
// =============================================================================
function gms_sparkline_points($seed_key, $count = 7, $min = 30, $max = 80) {
    $seed = crc32($seed_key . date('z'));
    mt_srand($seed);
    $points = [];
    for ($i = 0; $i < $count; $i++) {
        $points[] = mt_rand($min, $max);
    }
    mt_srand(); // reset
    return $points;
}

function gms_sparkline_svg($points, $width = 110, $height = 28) {
    $count = count($points);
    $maxVal = max($points);
    $minVal = min($points);
    $range = max($maxVal - $minVal, 1);
    $stepX = $width / max($count - 1, 1);
    $coords = [];
    foreach ($points as $i => $v) {
        $x = $i * $stepX;
        $y = $height - (($v - $minVal) / $range) * ($height - 4) - 2;
        $coords[] = round($x, 2) . ',' . round($y, 2);
    }
    $line = implode(' ', $coords);
    $areaLine = '0,' . $height . ' ' . $line . ' ' . $width . ',' . $height;
    return '<svg class="gms-sparkline" viewBox="0 0 ' . $width . ' ' . $height . '" preserveAspectRatio="none" aria-hidden="true">
        <polygon class="spark-area" points="' . $areaLine . '" />
        <polyline points="' . $line . '" />
    </svg>';
}

// Generate sparkline data for KPI cards
$spark_zones = gms_sparkline_points('zones', 7, 18, 24);
$spark_contractors = gms_sparkline_points('contractors', 7, 8, 16);
$spark_contracts = gms_sparkline_points('contracts', 7, 30, 60);
$spark_verified = gms_sparkline_points('verified', 7, 2, 12);

// Malay day name
$malay_days = ['Ahad' => 'Sunday', 'Isnin' => 'Monday', 'Selasa' => 'Tuesday', 'Rabu' => 'Wednesday', 'Khamis' => 'Thursday', 'Jumaat' => 'Friday', 'Sabtu' => 'Saturday'];
$today_eng = date('l');
$today_bm = array_search($today_eng, $malay_days) ?: $today_eng;
$today_date_bm = $today_bm . ', ' . date('d F Y');

// Cycle strip months (Malay short)
$cycle_months = ['Jan','Feb','Mac','Apr','Mei','Jun','Jul','Ogos','Sep','Okt','Nov','Dis'];
$current_month_num = (int)date('n');
