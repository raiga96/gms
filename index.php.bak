    <!-- Chart & Instant Search Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // 1. High-Tech Chart.js Bar Chart
            var canvas = document.getElementById('zoneContractsChart');
            if (canvas) {
                var ctx = canvas.getContext('2d');
                var chartLabels = <?php echo $chart_labels_json; ?>;
                var chartData = <?php echo $chart_data_json; ?>;

                // Create sleek gradient fill
                var gradient = ctx.createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, 'rgba(0, 116, 66, 0.85)');
                gradient.addColorStop(1, 'rgba(16, 185, 129, 0.25)');

                var hoverGradient = ctx.createLinearGradient(0, 0, 0, 300);
                hoverGradient.addColorStop(0, '#007442');
                hoverGradient.addColorStop(1, '#10b981');

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: chartLabels,
                        datasets: [{
                            label: 'Bilangan Kontrak',
                            data: chartData,
                            backgroundColor: gradient,
                            hoverBackgroundColor: hoverGradient,
                            borderColor: '#007442',
                            borderWidth: 1.5,
                            borderRadius: 8,
                            borderSkipped: false,
                            maxBarThickness: 32
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 1000,
                            easing: 'easeOutQuart'
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    font: {
                                        family: "'Outfit', sans-serif",
                                        size: 11
                                    },
                                    color: '#64748b'
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(226, 232, 240, 0.7)',
                                    drawBorder: false
                                },
                                ticks: {
                                    stepSize: 1,
                                    font: {
                                        family: "'Outfit', sans-serif",
                                        size: 11
                                    },
                                    color: '#64748b'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                align: 'end',
                                labels: {
                                    boxWidth: 12,
                                    boxHeight: 12,
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    font: {
                                        family: "'Outfit', sans-serif",
                                        size: 12,
                                        weight: '600'
                                    },
                                    color: '#334155'
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleFont: {
                                    family: "'Outfit', sans-serif",
                                    size: 13,
                                    weight: 'bold'
                                },
                                bodyFont: {
                                    family: "'Outfit', sans-serif",
                                    size: 12
                                },
                                padding: 12,
                                cornerRadius: 10,
                                displayColors: false
                            }
                        }
                    }
                });
            }

            // 2. Client-side Live Table Filter (Instant UX enhancement)
            var searchInput = document.getElementById('contractorTableSearch');
            var table = document.getElementById('contractorDashboardTable');
            var countLabel = document.getElementById('tableRecordCount');
            
            if (searchInput && table) {
                searchInput.addEventListener('keyup', function() {
                    var filter = searchInput.value.toLowerCase().trim();
                    var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
                    var visibleCount = 0;

                    for (var i = 0; i < rows.length; i++) {
                        var text = rows[i].textContent.toLowerCase();
                        if (text.indexOf(filter) > -1) {
                            rows[i].style.display = '';
                            visibleCount++;
                        } else {
                            rows[i].style.display = 'none';
                        }
                    }

                    if (countLabel) {
                        if (filter === '') {
                            countLabel.textContent = 'Memaparkan senarai penuh kontraktor berdaftar DBKU';
                        } else {
                            countLabel.textContent = 'Ditemui ' + visibleCount + ' kontraktor sepadan dengan carian "' + filter + '"';
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>